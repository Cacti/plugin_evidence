msgid "You can search serial number, firmware version, ip, mac address,..."
msgstr "Možete pretraživati serijski broj, verziju firmvera, IP, MAC adresu,..."

#: evidence_tab.php
msgid "Search string must be 3-20 characters"
msgstr "Niz za pretragu mora imati 3-20 znakova"

#: evidence_tab.php
msgid "Select any device, template, select any scan date or try search"
msgstr "Odaberite bilo koji uređaj, šablon, odaberite bilo koji datum skeniranja ili pokušajte pretragu"

#: evidence_tab.php
msgid "No data. Allow periodic scan and store history in settings"
msgstr "Nema podataka. Omogućite periodično skeniranje i čuvanje historije u postavkama"

#: evidence_tab.php
msgid "Device or template - You can display information about specific host, all devices with the same template."
msgstr "Uređaj ili šablon - Možete prikazati informacije o određenom hostu, svim uređajima s istim šablonom."

#: evidence_tab.php
msgid "Scan date (Only last changes or All history) - You can choose whether to retrieve only the most recent change or the entire history."
msgstr "Datum skeniranja (Samo zadnje promjene ili Sva historija) - Možete odabrati da li želite dohvatiti samo najnoviju promjenu ili cijelu historiju."

#: evidence_tab.php
msgid "If you use only `Scan Date`, the changes for all devices found during this scan will be displayed"
msgstr "Ako koristite samo `Datum skeniranja`, bit će prikazane promjene za sve uređaje pronađene tokom ovog skeniranja"

#: evidence_tab.php
msgid "You can search any string in all data."
msgstr "Možete pretraživati bilo koji niz u svim podacima."

