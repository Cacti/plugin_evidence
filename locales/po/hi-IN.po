#: evidence.php
msgid "Disabled/down device. No actual data"
msgstr "अक्षम/डाउन डिवाइस। कोई वास्तविक डेटा नहीं"

#: evidence.php
msgid "Show older records"
msgstr "पुराने रिकॉर्ड दिखाएं"

#: evidence.php includes/functions.php
msgid "History data store disabled"
msgstr "इतिहास डेटा संग्रह अक्षम है"

#: evidence.php
msgid "Permission issue"
msgstr "अनुमति समस्या"

