msgstr "ניתן לחפש מספר סידורי, גרסת קושחה, כתובת IP, כתובת MAC,..."

#: evidence_tab.php
msgid "Search string must be 3-20 characters"
msgstr "מחרוזת החיפוש חייבת להכיל 3-20 תווים"

#: evidence_tab.php
msgid "Select any device, template, select any scan date or try search"
msgstr "בחר התקן כלשהו, תבנית, בחר תאריך סריקה כלשהו או נסה לחפש"

#: evidence_tab.php
msgid "No data. Allow periodic scan and store history in settings"
msgstr "אין נתונים. אפשר סריקה תקופתית ושמירת היסטוריה בהגדרות"

#: evidence_tab.php
msgid "Device or template - You can display information about specific host, all devices with the same template."
msgstr ""
"התקן או תבנית - ניתן להציג מידע על מארח מסוים, או על כל ההתקנים בעלי אותה "
"תבנית."

#: evidence_tab.php
msgid "Scan date (Only last changes or All history) - You can choose whether to retrieve only the most recent change or the entire history."
msgstr ""
"תאריך סריקה (רק שינויים אחרונים או כל ההיסטוריה) - באפשרותך לבחור אם לאחזר "
"רק את השינוי האחרון או את כל ההיסטוריה."

#: evidence_tab.php
msgid "If you use only `Scan Date`, the changes for all devices found during this scan will be displayed"
msgstr ""
"אם תשתמש ב-`תאריך סריקה` בלבד, יוצגו השינויים עבור כל ההתקנים שנמצאו במהלך "
"סריקה זו"

#: evidence_tab.php
msgid "You can search any string in all data."
msgstr "ניתן לחפש כל מחרוזת בכל הנתונים."

