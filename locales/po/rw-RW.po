#: evidence_tab.php
msgid "Scan date (Only last changes or All history) - You can choose whether to retrieve only the most recent change or the entire history."
msgstr "Itariki y'isuzuma (Impinduka ziheruka gusa cyangwa Amateka yose) - Ushobora guhitamo niba ushaka kugarura gusa impinduka iheruka cyangwa amateka yose."

#: evidence_tab.php
msgid "If you use only `Scan Date`, the changes for all devices found during this scan will be displayed"
msgstr "Niba ukoresha gusa `Scan Date`, impinduka ku Bikoresho byose byabonetse muri iri suzuma zizagaragara"

