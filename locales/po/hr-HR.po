msgid "Search string must be 3-20 characters"
msgstr "Niz za pretraživanje mora imati 3-20 znakova"

#: evidence_tab.php
msgid "Select any device, template, select any scan date or try search"
msgstr "Odaberite bilo koji uređaj, predložak, odaberite bilo koji datum skeniranja ili pokušajte pretraživati"

#: evidence_tab.php
msgid "No data. Allow periodic scan and store history in settings"
msgstr "Nema podataka. Omogućite povremeno skeniranje i pohranu povijesti u postavkama"

#: evidence_tab.php
msgid "Device or template - You can display information about specific host, all devices with the same template."
msgstr "Uređaj ili predložak - Možete prikazati informacije o određenom glavnom računalu, svim uređajima s istim predloškom."

#: evidence_tab.php
msgid "Scan date (Only last changes or All history) - You can choose whether to retrieve only the most recent change or the entire history."
msgstr "Datum skeniranja (Samo zadnje promjene ili Sva povijest) - Možete odabrati želite li dohvatiti samo najnoviju promjenu ili cijelu povijest."

#: evidence_tab.php
msgid "If you use only `Scan Date`, the changes for all devices found during this scan will be displayed"
msgstr "Ako koristite samo `Datum skeniranja`, prikazat će se promjene za sve uređaje pronađene tijekom ovog skeniranja"

#: evidence_tab.php
msgid "You can search any string in all data."
